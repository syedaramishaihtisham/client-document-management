    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst data = item.json || {};\nconst binary = item.binary || {};\n\nconst files = Object.values(binary).map(file =>\n  (file.fileName || '').toLowerCase()\n);\n\nconst receivedDocuments = [];\nconst missingDocuments = [];\n\n// Required documents\nconst requiredDocuments = [\n  {\n    key: 'company_registration_certificate',\n    name: 'Company Registration Certificate'\n  },\n  {\n    key: 'tax_certificate',\n    name: 'Tax Certificate'\n  },\n  {\n    key: 'signed_service_agreement',\n    name: 'Signed Service Agreement'\n  }\n];\n\n// Check received and missing documents\nfor (const document of requiredDocuments) {\n  if (files.some(file => file.includes(document.key))) {\n    receivedDocuments.push(document.name);\n  } else {\n    missingDocuments.push(document.name);\n  }\n}\n\n// Check client information\nconst missingInformation = [];\n\nif (!data.client_name) missingInformation.push('Client Name');\nif (!data.contact_person) missingInformation.push('Contact Person');\nif (!data.client_email) missingInformation.push('Client Email');\nif (!data.project) missingInformation.push('Project');\n\nreturn [{\n  json: {\n    ...data,\n\n    received_documents:\n      receivedDocuments.length\n        ? receivedDocuments.join(', ')\n        : 'None',\n\n    missing_documents:\n      missingDocuments.length\n        ? missingDocuments.join(', ')\n        : 'None',\n\n    missing_information:\n      missingInformation.length\n        ? missingInformation.join(', ')\n        : 'None',\n\n    status: 'Incomplete'\n  },\n\n  binary\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
