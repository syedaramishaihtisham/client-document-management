      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary || {};\n\nconst output = [];\n\nfor (const [key, file] of Object.entries(binary)) {\n  output.push({\n    json: {\n      ...item.json,\n      binaryField: key,\n      fileName: file.fileName,\n      mimeType: file.mimeType,\n    },\n    binary: {\n      data: file\n    }\n  });\n}\n\nreturn output;"
